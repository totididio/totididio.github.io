---
layout: layouts/base.njk
title: "Talks and interviews · Salvatore Di Dio"
description: "TEDx talks, invited talks at international conferences, and interviews."
permalink: /talks/
---
<article class="page">
  <header class="page-head">
    <h1>Talks and interviews</h1>
    <p class="lede">To invite me to speak, write to <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
       I speak in English and Italian.</p>
  </header>

  <section class="sec" aria-labelledby="tedx">
    <div class="label">
      <h2 id="tedx">TEDx</h2>
    </div>
    <div class="body">
      <ul class="rows">
        {%- for t in [talks.featured].concat(talks.talks) %}
        <li class="featured">
          <span class="date">{{ t.year }}</span>
          <span class="what"><strong lang="{{ t.lang }}">{{ t.title }}</strong>
            <span class="where">{{ t.event or t.where }}</span>
            <a class="watch" href="{{ t.url }}" data-embed="{{ t.youtube }}" data-title="{{ t.title }}, {{ t.event or t.where }}">Watch the talk <span class="arrow" aria-hidden="true">&rarr;</span></a></span>
        </li>
        {%- endfor %}
      </ul>
      <p class="facade-note">The player loads from YouTube only when you
         click: from then on Google receives your IP address. <a href="/privacy/#video">More in the privacy page</a>.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="invited">
    <div class="label">
      <h2 id="invited">Selected international talks and events</h2>
    </div>
    <div class="body">
      <ul class="rows">
        {%- for t in talks.invited %}
        <li>
          <span class="date">{{ t.year }}</span>
          <span class="what">{% if t.url %}<a href="{{ t.url }}">{{ t.title }}</a>{% else %}{{ t.title }}{% endif %}
            <span class="where">{{ t.event }}{% if t.programme %} &middot; <a href="{{ t.programme }}">{{ t.programmeLabel or "programme" }}</a>{% endif %}</span></span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="interviews">
    <div class="label">
      <h2 id="interviews">Interviews and podcasts</h2>
    </div>
    <div class="body">
      <ul class="rows">
        {%- for t in talks.appearances | sort(true, false, "year") %}
        <li>
          <span class="date">{{ t.year }}</span>
          <span class="what"><a href="{{ t.url }}"{% if t.lang and t.lang != "en" %} lang="{{ t.lang }}"{% endif %}>{{ t.title }}</a>
            <span class="where">{{ t.where }}</span></span>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>
</article>

{% include "partials/facade-script.njk" %}
