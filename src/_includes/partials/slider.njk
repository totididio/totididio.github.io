{#- Photographs, newest first. The first loads with the page; the others only when you are about to
    reach them, so nobody pays for photos they never look at. Without JavaScript only
    the first is shown. -#}
<div class="slider" role="region" aria-roledescription="carousel" aria-label="Photographs">
  <div class="slides" tabindex="0">
  {%- for s in slides %}
    <figure class="slide{% if not loop.first %} later{% endif %}" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ slides.length }}">
      <img {% if loop.first %}src{% else %}data-lazy{% endif %}="/assets/img/{{ s.file }}.avif" width="1200" height="800" decoding="async" alt="{{ s.alt }}">
      <figcaption>{{ s.caption }} {{ s.credit or "Photograph by the author." }}</figcaption>
    </figure>
  {%- endfor %}
  </div>
  <div class="slider-nav" hidden>
    <button type="button" data-step="-1" aria-label="Previous photograph">&larr;</button>
    <span class="count" aria-live="polite">1 / {{ slides.length }}</span>
    <button type="button" data-step="1" aria-label="Next photograph">&rarr;</button>
  </div>
</div>
<script>(function(){var r=document.querySelector(".slider");if(!r)return;
var s=r.querySelector(".slides"),n=r.querySelector(".slider-nav"),c=r.querySelector(".count"),f=s.children,k=f.length;
r.classList.add("ready");n.hidden=false;
function load(j){var m=f[j]&&f[j].querySelector("img[data-lazy]");if(m){m.src=m.dataset.lazy;m.removeAttribute("data-lazy")}}
function at(){return Math.round(s.scrollLeft/s.clientWidth)}
function near(){var i=at();load(i);load(i+1)}
["pointerenter","focusin","touchstart"].forEach(function(e){r.addEventListener(e,near,{once:true,passive:true})});
n.addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;var j=(at()+(+b.dataset.step)+k)%k;load(j);load(j+1);s.scrollTo({left:j*s.clientWidth})});
s.addEventListener("scroll",function(){c.textContent=(at()+1)+" / "+k;near()},{passive:true})})();</script>
